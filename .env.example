# Copy to .env and fill in. All SOFT_FLOYD_* vars are also settable via
# ~/.soft-floyd/config.toml — see packages/core/src/soft_floyd_core/config.py.

# Required for book import/search and the coach chat.
SOFT_FLOYD_OPENAI_API_KEY=sk-...
# Coach chat refuses new turns once month-to-date LLM spend reaches this.
SOFT_FLOYD_LLM_MONTHLY_BUDGET_USD=10

# Optional overrides — defaults shown.
SOFT_FLOYD_DB_PATH=data/soft-floyd-accounts.db
SOFT_FLOYD_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SOFT_FLOYD_GOOGLE_CLIENT_SECRET=your-client-secret
SOFT_FLOYD_JWT_SECRET=replace-with-at-least-32-random-characters
# Register http://localhost:5173/api/auth/google/callback in Google Cloud.
SOFT_FLOYD_WEB_ORIGIN=http://localhost:5173
SOFT_FLOYD_GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Match the server's loopback port when overriding its default.
SOFT_FLOYD_INTERNAL_MCP_URL=http://127.0.0.1:8000/mcp
SOFT_FLOYD_LOG_LEVEL=INFO
SOFT_FLOYD_LTHR=165

# Garmin sync — see docs/product-specs/garmin-sync.md. No password var:
# `soft-floyd garmin-login` prompts for it once and never persists it,
# only the resulting token cache (at SOFT_FLOYD_GARMIN_TOKEN_DIR).
SOFT_FLOYD_GARMIN_EMAIL=you@example.com
SOFT_FLOYD_GARMIN_TOKEN_DIR=~/.soft-floyd/garmin
SOFT_FLOYD_FIT_DIR=data/fit
SOFT_FLOYD_GARMIN_POLL_ENABLED=true
SOFT_FLOYD_POLL_INTERVAL_MINUTES=10
SOFT_FLOYD_POLL_MAX_BACKOFF_MINUTES=60
SOFT_FLOYD_GARMIN_PAGE_SIZE=20
SOFT_FLOYD_GARMIN_LOGIN_COOLDOWN_MINUTES=30
