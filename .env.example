# Copy to .env and fill in. All SOFT_FLOYD_* vars are also settable via
# ~/.soft-floyd/config.toml — see packages/core/src/soft_floyd_core/config.py.

# Required once the coach agent starts making real calls (unused by the scaffold).
SOFT_FLOYD_OPENAI_API_KEY=sk-...

# Optional overrides — defaults shown.
SOFT_FLOYD_DB_PATH=data/soft-floyd.db
SOFT_FLOYD_LOG_LEVEL=INFO
SOFT_FLOYD_LTHR=165
